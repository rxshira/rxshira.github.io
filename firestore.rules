rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Site admin: the existing admin account (by account ID), or Google sign-in
    // with the verified CMU address. Add more account IDs here if needed.
    function isAdmin() {
      return signedIn() && (
        request.auth.uid in ['GXPa6y5Nt1aQYz4IZhOzRpIalxG2'] ||
        (request.auth.token.email == 'shirar@andrew.cmu.edu' && request.auth.token.email_verified == true)
      );
    }

    // ---- Personal website content: anyone can read, only the admin can change it.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Carpool app: signed-in users only.
    match /carpool_users/{userId} {
      allow read: if signedIn();
      allow delete: if isAdmin();

      // Users can create/edit only their own profile, can't make themselves admin,
      // and can only put themselves into 'pending' review (never approve themselves).
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == userId &&
        request.resource.data.get('is_admin', false) == false &&
        request.resource.data.get('access_status', 'pending') == 'pending'
      );
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_admin']) &&
        (request.resource.data.get('access_status', null) == resource.data.get('access_status', null) ||
         request.resource.data.access_status == 'pending')
      );
    }

    match /carpools/{poolId} {
      allow read, write: if signedIn();
    }

    match /ride_requests/{requestId} {
      allow read, write: if signedIn();
    }

    match /system_logs/{logId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // Everything else is closed.
  }
}
